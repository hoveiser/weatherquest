# Copy to .env and fill in. NEVER commit .env — it is git-ignored.

# Private key used ONLY for local contract deployment to a test network.
# Keep this out of any committed file. Rotate if it ever leaks.
GENLAYER_PRIVATE_KEY=

# GitHub personal access token for repo creation / Pages deployment (scopes: repo, workflow).
GITHUB_TOKEN=

# Deployed contract address (filled after Task 7 deployment).
WEATHERQUEST_CONTRACT_ADDRESS=

# GenLayer network: studionet | testnet-bradbury | localnet
GENLAYER_NETWORK=studionet
