# Copy to .env and fill in. NEVER commit .env - it is git-ignored.

# Private key used ONLY for local contract deployment to a test network.
# Keep this out of any committed file. Rotate if it ever leaks.
GENLAYER_PRIVATE_KEY=

# GitHub personal access token for repo creation / Pages deployment (scopes: repo, workflow).
GITHUB_TOKEN=

# Deployed contract address on StudioNet (public, safe to commit: it is only an address).
# Current layered-verification deployment; see README §10 for the previous ones.
WEATHERQUEST_CONTRACT_ADDRESS=0x8b317B94AF764e9de587805d264CbBea59Ce3aE2

# Same address consumed by the frontend. Copy into frontend/.env.local to drive the
# live UI (add VITE_ONCHAIN=true only if you also want the marketplace flows to attempt
# on-chain calls; the campaign path needs the address alone).
VITE_CONTRACT_ADDRESS=0x8b317B94AF764e9de587805d264CbBea59Ce3aE2

# GenLayer network: studionet | testnet-bradbury | localnet
GENLAYER_NETWORK=studionet
