# Secrets - never commit
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local
# tsc-generated Vite config artifacts (regenerated by `npm run build`)
frontend/vite.config.js
frontend/vite.config.d.ts

# GenLayer / genvm artifacts
gltest.config.local.yaml
.genlayer/

# Media / build outputs
*.mp4
*.webm
demo/*.mp4
# Everything under media/ is a video-generation artifact: raw recording, final
# webm/mp4, extracted check frames, SRT, and the captions log. Only the ffmpeg
# script and docs/demo-youtube.txt belong in git.
media/
media/build/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Build caches / logs - never commit
*.tsbuildinfo
*.log

# Local tool caches - never commit
.freebuff/
